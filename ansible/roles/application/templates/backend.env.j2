# {{ ansible_managed }}
# Rendered by Ansible from group_vars — DO NOT edit directly on the server,
# it will be overwritten on the next deploy. Edit ansible/group_vars/all.yml
# (or your Vault-encrypted secrets) instead.

NODE_ENV=production

MONGO_URI={{ mongo_uri }}

JWT_SECRET={{ jwt_secret }}
JWT_EXPIRE={{ jwt_expire | default('7d') }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret }}
JWT_REFRESH_EXPIRE={{ jwt_refresh_expire | default('30d') }}

GROQ_API_KEY={{ groq_api_key }}
OPENAI_API_KEY={{ openai_api_key }}

CLOUDINARY_CLOUD_NAME={{ cloudinary_cloud_name }}
CLOUDINARY_API_KEY={{ cloudinary_api_key }}
CLOUDINARY_API_SECRET={{ cloudinary_api_secret }}

CLIENT_URL={{ client_url }}
BACKEND_URL={{ backend_url }}

GOOGLE_CLIENT_ID={{ google_client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ google_client_secret | default('') }}
GOOGLE_CALLBACK_URL={{ google_callback_url | default('') }}

ADZUNA_APP_ID={{ adzuna_app_id | default('') }}
ADZUNA_APP_KEY={{ adzuna_app_key | default('') }}

RATE_LIMIT_WINDOW_MS={{ rate_limit_window_ms | default('900000') }}
RATE_LIMIT_MAX={{ rate_limit_max | default('100') }}
