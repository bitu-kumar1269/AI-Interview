# ─────────────────────────────────────────────────────────────────
# AI-Interviewer — required secrets, consolidated across backend/
# and infra. This file documents NAMES ONLY — no real values.
#
# Where each one is actually configured:
#   - Local dev:        backend/.env and frontend/.env
#   - AWS deployment:   ansible/group_vars/all.yml (Vault-encrypted)
#                        OR GitHub Secrets (used by .github/workflows/deploy.yml)
# ─────────────────────────────────────────────────────────────────

# ── Backend runtime ──────────────────────────────────────────────
NODE_ENV=
PORT=

# ── Database (MongoDB Atlas — external, managed, not containerized) ──
MONGO_URI=

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=

# ── AI providers ──────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=

# ── File storage ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── URLs (CORS + OAuth redirects) ──────────────────────────────────
CLIENT_URL=
BACKEND_URL=

# ── OAuth (Google) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Job listings ──────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# ── Frontend (build-time, baked into the static bundle) ────────────
VITE_API_URL=
VITE_APP_NAME=

# ── Redis ────────────────────────────────────────────────────────
# Not a secret, but worth documenting: in docker-compose.prod.yml
# this is hardcoded to redis://redis:6379 (the in-stack container),
# so it does NOT need to be set as a GitHub Secret / Ansible var.
# REDIS_URL=redis://redis:6379
