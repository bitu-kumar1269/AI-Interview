# Terraform state & plans (state can contain sensitive infrastructure details)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/tfplan
terraform/terraform.tfvars
terraform/crash.log
# (terraform/.terraform.lock.hcl SHOULD be committed)

# Ansible generated / secret files
ansible/inventory/hosts.ini
ansible/inventory/group_vars/all/vault.yml
ansible/.vault_pass
*.retry

# Keys and credentials
*.pem
*.ppk
.env
.venv/
.venv314/
