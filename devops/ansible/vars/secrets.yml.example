# Copy this file to secrets.yml (same folder) and fill in real values.
# secrets.yml is gitignored - never commit real secrets.
# This gets written into backend/.env on the server during deployment.

app_repo: "https://github.com/YOUR_USERNAME/AI-Interviewer.git"
git_branch: "main"

backend_env:
  PORT: "5000"
  NODE_ENV: "production"
  MONGO_URI: "mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_interview_db?retryWrites=true&w=majority"
  JWT_SECRET: "replace_me_min_32_chars"
  JWT_EXPIRE: "7d"
  JWT_REFRESH_SECRET: "replace_me_min_32_chars"
  JWT_REFRESH_EXPIRE: "30d"
  GROQ_API_KEY: "your_groq_api_key_here"
  OPENAI_API_KEY: "your_openai_api_key_here"
  CLOUDINARY_CLOUD_NAME: "your_cloudinary_cloud_name"
  CLOUDINARY_API_KEY: "your_cloudinary_api_key"
  CLOUDINARY_API_SECRET: "your_cloudinary_api_secret"
  CLIENT_URL: "http://REPLACE_WITH_TERRAFORM_OUTPUT_IP"
  BACKEND_URL: "http://REPLACE_WITH_TERRAFORM_OUTPUT_IP/api"
  GOOGLE_CLIENT_ID: "your_google_client_id"
  GOOGLE_CLIENT_SECRET: "your_google_client_secret"
  GOOGLE_CALLBACK_URL: "http://REPLACE_WITH_TERRAFORM_OUTPUT_IP/api/auth/google/callback"
  GITHUB_CLIENT_ID: "your_github_client_id"
  GITHUB_CLIENT_SECRET: "your_github_client_secret"
  GITHUB_CALLBACK_URL: "http://REPLACE_WITH_TERRAFORM_OUTPUT_IP/api/auth/github/callback"
  LINKEDIN_CLIENT_ID: "your_linkedin_client_id"
  LINKEDIN_CLIENT_SECRET: "your_linkedin_client_secret"
  LINKEDIN_CALLBACK_URL: "http://REPLACE_WITH_TERRAFORM_OUTPUT_IP/api/auth/linkedin/callback"
  RATE_LIMIT_WINDOW_MS: "900000"
  RATE_LIMIT_MAX: "100"

frontend_env:
  VITE_API_URL: "http://REPLACE_WITH_TERRAFORM_OUTPUT_IP/api"
