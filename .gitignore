# ── Root .gitignore — infra & deployment artifacts ──────────────────
# (backend/ and frontend/ each have their own .gitignore for app-level files)

# OS
.DS_Store

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan
terraform/crash.log

# Ansible
ansible/inventory.ini
ansible/group_vars/all.yml
ansible/*.retry
ansible/vault_pass.txt

# Docker env file generated/placed on the server at deploy time —
# never committed, contains real secrets
backend.env

# SSH keys — never commit these
*.pem
*.ppk
id_rsa
id_rsa.pub
